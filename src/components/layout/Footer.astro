---
import { RATE_CARD_FOOTER } from '../../data/rate-card.js';
import { CONTACT_LINES, EMAIL } from '../../data/contact.js';
import ContactLine from '../ContactLine.astro';
---

<div class="footer-markstrip">
  <div class="wrap">
    <img class="footer__mark" src="/images/grandbelle-lockup.png" width="1000" height="313" alt="Grandbelle International Inc">
  </div>
</div>

<footer class="site-footer site-footer--dark">
  <div class="wrap">
    <div class="footer__grid">
      <div class="stack">
        <h2 class="h4">Grandbelle International Inc</h2>
        <p class="body-sm">Air freight, ocean freight, customs clearance, auto shipping, warehousing, and door-to-door delivery from the United States to Nigeria and West Africa.</p>
      </div>
      <div class="stack">
        <h2 class="h4">Services</h2>
        <ul class="footer__list body-sm">
          <li><a href="/shop-and-ship/">Shop and ship</a></li>
          <li><a href="/what-can-i-ship/">What can I ship?</a></li>
          <li><a href="/#services">All six services</a></li>
        </ul>
      </div>
      <div class="stack">
        <h2 class="h4">Offices</h2>
        <address class="body-sm">
          Airport Industrial Office Park, 145 Hook Creek Blvd, A7, Valley Stream, NY 11581, United States<br><br>
          123 Toyin Street, Ikeja, Lagos, Nigeria
        </address>
      </div>
      <div class="stack">
        <h2 class="h4">Contact</h2>
        <ul class="footer__list body-sm">
          {CONTACT_LINES.map(line => (
            <li><a href={line.href}><ContactLine line={line} /></a></li>
          ))}
          <li><a href="tel:+2348035137916">Lagos <span class="phone-num">+234 803 513 7916</span></a></li>
          <li><a href={EMAIL.href}>{EMAIL.display}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <p class="caption">Grandbelle International Inc.{RATE_CARD_FOOTER ? ' ' + RATE_CARD_FOOTER : ''}</p>
    </div>
  </div>
</footer>
