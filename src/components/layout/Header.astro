---
import {
  CONTACT_LINES,
  PHONE_LINES_LIVE,
  SUPPORT_PHONE,
  WHATSAPP_PRIMARY,
  WHATSAPP_SECONDARY,
  lineLabel,
} from '../../data/contact.js';
import ContactLine from '../ContactLine.astro';

interface Props {
  currentPage?: string;
}
const { currentPage = '' } = Astro.props;

/**
 * The owner-approved primary navigation, 2026-11-03, in this order.
 *
 * "Services" points at the services section of the home page (#services): there
 * is no /services/ page, only a redirect, so that href keeps the link on the
 * real page and it never matches `currentPage` — no aria-current, deliberately.
 *
 * "Home" is gone (the logo goes home) and the duplicate "Get a quote" text link
 * is gone (the button in the bar is the single call to action). Labels are
 * owner copy: do not re-word.
 */
const navLinks = [
  { href: '/#services', label: 'Services' },
  { href: '/shop-and-ship/', label: 'Shop & ship' },
  { href: '/shipping-a-car/', label: 'Ship a car' },
  { href: '/track/', label: 'Track a shipment' },
  { href: '/about/', label: 'About' },
];

const QUOTE_HREF = '/get-a-quote/';

/** aria-current="page" only on the page you are actually on. */
const ariaCurrent = (href: string) => (href === currentPage ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <img class="brand__emblem" src="/images/grandbelle-emblem-square.png" width="346" height="357" alt="Grandbelle International Inc">
      <img class="brand__lockup" src="/images/grandbelle-lockup.png" width="1000" height="313" alt="Grandbelle International Inc">
    </a>
    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {navLinks.map(link => (
          <li>
            <a
              class="nav__link"
              href={link.href}
              aria-current={ariaCurrent(link.href)}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <span class="nav__spacer"></span>
    {PHONE_LINES_LIVE ? (
      <a class="nav__support" href={SUPPORT_PHONE.href}>{SUPPORT_PHONE.label}</a>
    ) : (
      <span class="nav__support nav__support--lines">
        <a href={WHATSAPP_PRIMARY.href}>{lineLabel(WHATSAPP_PRIMARY)}</a>
        <a href={WHATSAPP_SECONDARY.href}>{lineLabel(WHATSAPP_SECONDARY)}</a>
      </span>
    )}
    <a class="btn btn--primary header__action" href={QUOTE_HREF}>Get a quote</a>
    <details class="drawer">
      <summary>Menu</summary>
      <nav class="drawer__panel" aria-label="Primary, mobile">
        <ul class="drawer__list">
          {navLinks.map(link => (
            <li>
              <a class="nav__link" href={link.href} aria-current={ariaCurrent(link.href)}>{link.label}</a>
            </li>
          ))}
          <li><a class="nav__link" href={QUOTE_HREF} aria-current={ariaCurrent(QUOTE_HREF)}>Get a quote</a></li>
          {CONTACT_LINES.map(line => (
            <li><a class="nav__link" href={line.href}><ContactLine line={line} /></a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
