---
interface Props {
  title: string;
  body: string;
  badge?: string;
  badgeVariant?: 'info' | 'success' | 'warning' | 'error';
  imageSrc?: string;
  imageAlt?: string;
}
const { title, body, badge, badgeVariant = 'info', imageSrc, imageAlt } = Astro.props;
---

<article class="plate">
  {imageSrc ? (
    <div class="plate__media">
      <img src={imageSrc} width="1200" height="800" alt={imageAlt || ''}>
    </div>
  ) : (
    <div class="plate__media">
      <div class="media">
        <p class="media__note">Photography placeholder<br>Client photography to supply</p>
      </div>
    </div>
  )}
  <div class="plate__text">
    <h3 class="h4">{title}</h3>
    <p class="card__body">{body}</p>
    {badge && (
      <p class="card__meta">
        <span class={`badge badge--${badgeVariant}`}>{badge}</span>
      </p>
    )}
  </div>
</article>
