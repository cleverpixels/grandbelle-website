---
import { CONTACT_LINES, PHONE_LINES_LIVE, lineLabel } from '../../data/contact.js';

interface Props {
  eyebrow: string;
  heading: string;
  lead: string;
  facts: {
    label: string;
    figure: string;
    description: string;
    highlight?: boolean;
  }[];
  showQuotePrompt?: boolean;
}
const { eyebrow, heading, lead, facts, showQuotePrompt = false } = Astro.props;
---

<section class="answerband" aria-label="How much, how long, and where is it now">
  <div class="wrap answerband__inner">
    <div class="stack stack--wide answerband__text">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="h1">{heading}</h1>
      <div class="answerband__facts">
        {facts.map(fact => (
          <div class={`fact${fact.highlight ? ' fact--now' : ''}`}>
            <p class="caption">{fact.label}</p>
            <p class="fact__figure num">{fact.figure}</p>
            <p class="fact__label body-sm">{fact.description}</p>
          </div>
        ))}
      </div>
      <p class="lead">{lead}</p>
    </div>

    <div class="answerband__card">
      <div class="stack stack--tight">
        <p class="label">Shipment status</p>
        <p class="body-sm muted">Online tracking is not available yet. Message the office and we will confirm where your consignment is.</p>
        <a class="btn btn--secondary" href="/track/">How to check a status</a>
      </div>
      {showQuotePrompt && (
        <div class="stack stack--tight">
          <p class="label">Price a consignment</p>
          <p class="body-sm muted">Air, express, sea, or a vehicle. One estimate, labelled as one.</p>
          <a class="btn btn--secondary" href="/get-a-quote/">Price my consignment</a>
        </div>
      )}
      <div class="stack stack--tight">
        <p class="label">{PHONE_LINES_LIVE ? 'Prefer to talk' : 'Message the office'}</p>
        {CONTACT_LINES.map(line => (
          <p class="body-sm"><a href={line.href}>{lineLabel(line)}</a></p>
        ))}
      </div>
    </div>
  </div>
</section>
