---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Favicons from '../components/layout/Favicons.astro';
import LaneCards from '../components/bands/LaneCards.astro';
import { cardFigure, RATE_CARD_NOTICE, TRANSIT, TRANSIT_SHORT } from '../data/rate-card.js';
import QuoteEstimator from '../components/QuoteEstimator.jsx';
import ContactLine from '../components/ContactLine.astro';
import {
  PHONE_LINES_LIVE,
  SUPPORT_PHONE,
  WHATSAPP_PRIMARY,
  WHATSAPP_SECONDARY,
} from '../data/contact.js';
import '../styles/global.css';

const laneCards = [
  { eyebrow: 'Fastest', title: 'Air freight, express', time: TRANSIT_SHORT.express, ...cardFigure('express'), fastest: true },
  { title: 'Air freight, standard', time: TRANSIT_SHORT.air, ticks: ['Consolidation available'], ...cardFigure('air') },
  { title: 'Auto shipping', time: TRANSIT_SHORT.auto, ticks: ['Collected from origin address'], ...cardFigure('auto') },
  { title: 'Barrel shipment', time: TRANSIT_SHORT.barrel, ticks: ['Flat rate per barrel'], ...cardFigure('barrel') },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Get a quote | Grandbelle International Inc</title>
  <meta name="description" content="Price a consignment from the United States to Nigeria and West Africa. Choose the service, the destination and the weight, and the estimate appears beside the form. No account required.">
  <link rel="preconnect" href="/fonts/roboto-slab-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preconnect" href="/fonts/roboto-400-500-600.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/fonts/fonts.css">
  <Favicons />
  <script is:inline src="https://embed.tawk.to/6aa967c3d1963a3449b3b83e/default" async></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <Header currentPage="/get-a-quote/" />
  <main id="main">
    <section class="answerband" aria-label="Price a consignment">
      <div class="wrap answerband__inner">
        <div class="stack stack--wide answerband__text">
          <p class="eyebrow">Get a quote</p>
          <h1 class="h1">An estimate beside the form, <span>before you speak to anyone</span>.</h1>
          <div class="answerband__facts">
            <div class="fact">
              <p class="caption">How long</p>
              <p class="fact__figure num">{TRANSIT_SHORT.air}</p>
              <p class="fact__label body-sm">Business days by air, door to door. By sea, {TRANSIT.ocean}. Indicative.</p>
            </div>
            <div class="fact">
              <p class="caption">Paid when</p>
              <p class="fact__figure num">On confirmation</p>
              <p class="fact__label body-sm">Nothing is charged until the figure is confirmed and the consignment is booked.</p>
            </div>
          </div>
          <p class="lead">No account, no payment, and no telephone call required. Enter the consignment and the estimate appears beside it, with the inputs it was calculated from named underneath.</p>
        </div>
        <div class="answerband__card">
          <QuoteEstimator client:load />
          <div class="stack stack--tight">
            <h2 class="h4">Send the details on WhatsApp</h2>
            <p class="body-sm muted">The figure above is an estimate, not a booking. Send the same details to the office on WhatsApp and they will confirm the figure and the departure.</p>
            <a class="btn btn--primary" href={WHATSAPP_PRIMARY.href} data-quote-request><ContactLine line={WHATSAPP_PRIMARY} /></a>
          </div>
          <p class="caption"><a href="/what-can-i-ship/">Check what you can ship before you book</a></p>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap band__inner">
        <div class="stack stack--tight">
          <h2 class="h2">What happens next</h2>
          <p class="muted measure">Three steps, and the middle one is where the figure stops being an estimate.</p>
        </div>
        <div class="grid grid--cards">
          <div class="card">
            <p class="eyebrow num">01</p>
            <h3 class="h4">The estimate appears</h3>
            <p class="card__body">Beside the form, with the weight, destination, and service it was calculated from named under the figure.</p>
          </div>
          <div class="card">
            <p class="eyebrow num">02</p>
            <h3 class="h4">We confirm the figure</h3>
            <p class="card__body">The office confirms the departure, the exact figure, and any duty payable at the destination. Nothing is charged before this.</p>
          </div>
          <div class="card">
            <p class="eyebrow num">03</p>
            <h3 class="h4">The consignment moves</h3>
            <p class="card__body">Received at the warehouse, given one tracking number, carried, cleared, and delivered to the address.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="band band--surface">
      <div class="wrap band__inner">
        <div class="stack stack--tight">
          <h2 class="h2">Service levels, fastest first</h2>
          <p class="muted measure">Choose a level here, then set the service above to match.{RATE_CARD_NOTICE ? ' Figures are samples in United States dollars.' : ''}</p>
        </div>
        <LaneCards cards={laneCards} />
        {RATE_CARD_NOTICE && (
          <div class="alert alert--attention">
            <p class="label">{RATE_CARD_NOTICE.label}</p>
            <p>{RATE_CARD_NOTICE.body}</p>
          </div>
        )}
      </div>
    </section>

    <section class="band">
      <div class="wrap band__inner">
        <div class="stack stack--tight">
          <p class="label">{PHONE_LINES_LIVE ? 'Prefer to speak to someone' : 'Prefer to message someone'}</p>
          {PHONE_LINES_LIVE ? (
            <p class="body-sm">The telephone and WhatsApp entries sit second to the estimate, not in place of it. <a href={SUPPORT_PHONE.href}><span class="phone-num">{SUPPORT_PHONE.display}</span></a>.</p>
          ) : (
            <p class="body-sm">The estimate above is a figure, not a booking. Send it to the office on WhatsApp and they will confirm it: primary <span class="phone-num">{WHATSAPP_PRIMARY.display}</span>, secondary <a href={WHATSAPP_SECONDARY.href}><span class="phone-num">{WHATSAPP_SECONDARY.display}</span></a>.</p>
          )}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</body>
</html>
